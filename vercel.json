{
  "version": 2,
  "functions": {
    "api/payments/**/*.js": {
      "includeFiles": "server/**"
    },
    "api/webhooks/**/*.js": {
      "includeFiles": "server/**"
    },
    "api/health.js": {
      "includeFiles": "server/loadEnv.js"
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/webhooks/paymongo", "destination": "/api/webhooks/paymongo" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
