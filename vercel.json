{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/webhooks/paymongo", "destination": "/api/webhooks/paymongo" },
    { "source": "/((?!api/|webhooks/|health|static/).*)", "destination": "/index.html" }
  ]
}
