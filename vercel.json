{
  "version": 2,
  "functions": {
    "api/payments/**/*.js": {
      "includeFiles": "server/**"
    },
    "api/webhooks/**/*.js": {
      "includeFiles": "server/**"
    },
    "api/health.js": {
      "includeFiles": "server/**"
    }
  },
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/webhooks/paymongo", "destination": "/api/webhooks/paymongo" },
    {
      "source": "/((?!api/|webhooks/|health|static/|sitemap\\.xml|robots\\.txt|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
