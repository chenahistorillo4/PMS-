{
  "version": 2,
  "functions": {
    "api/payments/**/*.js": {
      "includeFiles": "server/**"
    },
    "api/webhooks/**/*.js": {
      "includeFiles": "server/**"
    },
    "api/notifications/**/*.js": {
      "includeFiles": "server/**"
    },
    "api/cron/**/*.js": {
      "includeFiles": "server/**"
    },
    "api/health.js": {
      "includeFiles": "server/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/boarding-reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/payment-expiry",
      "schedule": "* * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/webhooks/paymongo", "destination": "/api/webhooks/paymongo" },
    { "source": "/api/notifications/email", "destination": "/api/notifications/send" },
    { "source": "/((?!api/|Marinduque/|Pinamalayan/|Sibale/).*)", "destination": "/index.html" }
  ]
}
