{
  "version": 2,
  "functions": {
    "api/payments/**/*.js": {
      "includeFiles": "server/**"
    },
    "api/webhooks/**/*.js": {
      "includeFiles": "server/**"
    },
    "api/health.js": {
      "includeFiles": "server/loadEnv.js"
    }
  },
  "redirects": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap/sitemap.xml",
      "permanent": false
    }
  ],
  "routes": [
    { "src": "/health", "dest": "/api/health" },
    { "src": "/webhooks/paymongo", "dest": "/api/webhooks/paymongo" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
