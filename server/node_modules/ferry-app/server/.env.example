API_PORT=5001

# Comma-separated allowed browser origins (local dev)
CLIENT_ORIGIN=http://localhost:3000,http://localhost:3001

# PayMongo secret key (sk_test_... or sk_live_...)
PAYMONGO_SECRET_KEY=

# Optional: webhook signing secret from PayMongo dashboard
PAYMONGO_WEBHOOK_SECRET=

# Firebase Admin service account JSON (single line) for webhook booking updates
FIREBASE_PROJECT_ID=pms-ferry
FIREBASE_SERVICE_ACCOUNT_JSON=

# Gmail sender for email notifications (use a Google App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional sender display name
GMAIL_FROM_NAME=PMS Port

# TextBee SMS gateway (https://textbee.dev)
TEXTBEE_API_KEY=
# Optional: target a specific Android device instead of the default
TEXTBEE_DEVICE_ID=

# Comma-separated admin phone numbers for SMS alerts (e.g. 09171234567)
ADMIN_NOTIFICATION_PHONES=

# Copy this file to server/.env and fill in the values for local development.
# In production, configure these values in your hosting provider's environment settings.
# PAYMONGO_SECRET_KEY is shared by all admins; use the merchant account that receives all payments.
