PORT=5001

# Comma-separated allowed browser origins (local dev)
CLIENT_ORIGIN=http://localhost:3000,http://localhost:3001

# PayMongo secret key (sk_test_... or sk_live_...)
PAYMONGO_SECRET_KEY=

# Optional: webhook signing secret from PayMongo dashboard
PAYMONGO_WEBHOOK_SECRET=

# Firebase Admin service account JSON (single line) for webhook booking updates
FIREBASE_SERVICE_ACCOUNT_JSON=

# Copy this file to server/.env and fill in the values.
# Used for local dev and Vercel — no separate Vercel env setup needed.
